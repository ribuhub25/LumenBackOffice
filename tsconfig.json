{
  "compilerOptions": {
    "typeRoots": ["src/@types", "node_modules/@types"],
    "types": ["node", "express","jest"],
    "module": "CommonJS",
    "target": "ES2021",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist"
  },
  "include": ["src", "tests", "src/@types/**/*.d.ts"]
}